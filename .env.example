# PostgreSQL yang sudah dipakai aplikasi
DATABASE_URL=

# Kode aktivasi acak minimal 32 karakter untuk membuat Owner pertama.
# Hanya simpan di lingkungan hosting, jangan masukkan nilai asli ke Git.
# Otomatis tidak berlaku setelah akun Owner pertama terbentuk.
AUTH_SETUP_TOKEN=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Penyimpanan lampiran (jika digunakan)
BLOB_READ_WRITE_TOKEN=
