# PostgreSQL (Neon, Supabase, atau PostgreSQL standar)
DATABASE_URL=

# Google Identity Services: Web application client ID (bukan client secret).
# Tambahkan origin deployment dan localhost pada Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# Email Google pemilik pertama, dikonfirmasi oleh pengelola TIDIGO.
# Dipakai sekali untuk bootstrap; akun berikutnya didaftarkan oleh Owner.
AUTH_OWNER_EMAIL=

# URL publik deployment, digunakan untuk metadata dan callback
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob private atau storage lain
BLOB_READ_WRITE_TOKEN=

# Integrasi MLS OIDC/OAuth 2.0
MLS_ISSUER_URL=
MLS_CLIENT_ID=
MLS_CLIENT_SECRET=
MLS_CALLBACK_URL=http://localhost:3000/api/v1/auth/callback
MLS_STUDENT_ACCOUNT_TYPES=student,siswa

# Kunci sesi aplikasi (minimal 32 karakter acak)
SESSION_SECRET=
